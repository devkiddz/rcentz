}

enum ReactionType {
  LIKE
  LOVE
  CLAP
  FIRE
  INSIGHTFUL
  CELEBRATE
  UPVOTE
  DOWNVOTE
}

enum ConversationType {
  DIRECT
  PROJECT
  SERVICE
  ORDER
  SUPPORT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  FILE
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROJECT
  PROJECT_UPDATE
  SERVICE
  ORDER
  PAYMENT
  COMMENT
  REACTION
  TICKET
  ASSISTANCE
  COMMERCE
}

enum AssistanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  WAITING_FOR_STAFF
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  PROGRESS_UPDATED
  MILESTONE_COMPLETED
  COMMENTED
  ATTACHED
  PAYMENT_RECEIVED
  DEPLOYED
  COMPLETED
  ASSIGNED
  UNASSIGNED
  OTHER
}

enum AnalyticsEventType {
  PAGE_VIEW
  PROJECT_VIEW
  PRODUCT_VIEW
  SERVICE_VIEW
  SEARCH
  CLICK
  REACTION
  COMMENT
  SHARE
  DOWNLOAD
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_STARTED
  PURCHASE
  SERVICE_REQUEST
  SIGN_UP
  LOGIN
  OTHER
}

enum SeoRobots {
  INDEX_FOLLOW
  INDEX_NOFOLLOW
  NOINDEX_FOLLOW
  NOINDEX_NOFOLLOW
}

// =========================================================
// USERS / AUTHENTICATION
// Better Auth owns the core account/session contract.
// Role and status authorization remains server-enforced.
// =========================================================

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  phone         String?
  bio           String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastSeenAt    DateTime?

  accounts Account[]
  sessions Session[]

  clientProfile ClientProfile?
  staffProfile  StaffProfile?

  clientProjects Project[] @relation("ProjectClient")

  assignedProjects    ProjectAssignment[]
  createdAttributions ProjectAttribution[]

  createdMilestones    ProjectMilestone[]           @relation("MilestoneCreator")
  milestoneAssignments ProjectMilestoneAssignment[]

  createdFeatures   ProjectFeature[] @relation("FeatureCreator")
  nominatedFeatures ProjectFeature[] @relation("FeatureNominator")
  assignedFeatures  ProjectFeature[] @relation("FeatureAssignee")

  createdTasks  ProjectTask[] @relation("TaskCreator")
  assignedTasks ProjectTask[] @relation("TaskAssignee")

  createdProjectUpdates ProjectUpdate[]   @relation("ProjectUpdateAuthor")
  projectActivities     ProjectActivity[]
  uploadedProjectFiles  ProjectFile[]     @relation("ProjectFileUploader")

  serviceRequests ServiceRequest[]
  quotes          Quote[]          @relation("QuoteClient")

  orders Order[]
  carts  Cart[]

  comments  Comment[]
  reactions Reaction[]

  conversations ConversationParticipant[]
  sentMessages  Message[]                 @relation("MessageSender")

  notifications          Notification[]
  notificationPreference NotificationPreference?

  assistanceRequests AssistanceRequest[]

  createdTickets  SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")

  analyticsEvents   AnalyticsEvent[]
  analyticsSessions AnalyticsSession[]

  auditLogs AuditLog[]

  createdServices Service[]  @relation("ServiceCreator")
  authoredPosts   BlogPost[] @relation("PostAuthor")

  mediaAssets MediaAsset[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([providerId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// =========================================================
// CLIENT / STAFF
// =========================================================

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  companyLogo String?
  website     String?
  phone       String?
  bio         String?
  address     String?
  city        String?
  state       String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  jobTitle         String?
  department       String?
  employeeNumber   String?          @unique
  employmentStatus EmploymentStatus @default(ACTIVE)
  joinedAt         DateTime?
  terminatedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// SERVICES
// =========================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id               String        @id @default(cuid())
  categoryId       String?
  createdById      String
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  type             ProjectType
  status           ServiceStatus @default(DRAFT)
  priceFrom        Decimal?      @db.Decimal(14, 2)
  priceTo          Decimal?      @db.Decimal(14, 2)
  currency         String        @default("NGN")
  featured         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category  ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  requests ServiceRequest[]
  media    MediaAsset[]
  seo      SeoMetadata?

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([featured])
}

model ServiceRequest {
  id          String               @id @default(cuid())
  userId      String
  serviceId   String
  title       String
  description String
  budget      Decimal?             @db.Decimal(14, 2)
  currency    String               @default("NGN")
  status      ServiceRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  service Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quote   Quote?
  project Project?

  conversations Conversation[]

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
}

model Quote {
  id               String      @id @default(cuid())
  serviceRequestId String      @unique
  clientId         String
  quoteNumber      String      @unique
  subtotal         Decimal     @db.Decimal(14, 2)
  discount         Decimal     @default(0) @db.Decimal(14, 2)
  tax              Decimal     @default(0) @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  currency         String      @default("NGN")
  status           QuoteStatus @default(DRAFT)
  validUntil       DateTime?
  sentAt           DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  client         User           @relation("QuoteClient", fields: [clientId], references: [id], onDelete: Restrict)
  items          QuoteItem[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  name        String
  description String?
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// =========================================================
// PROJECT MANAGEMENT — CANONICAL PROJECT SOURCE
// Execution hierarchy: Project -> Milestone -> Feature -> Task.
// A feature with milestoneId = null is backlog/unscheduled work.
// Cross-project invariants remain server-enforced.
// =========================================================

model Project {
  id               String  @id @default(cuid())
  clientId         String?
  serviceRequestId String? @unique

  name            String
  slug            String  @unique
  description     String?
  purpose         String?
  vision          String?
  expectedOutcome String?

  type       ProjectType
  status     ProjectStatus     @default(PLANNING)
  visibility ProjectVisibility @default(PRIVATE)

  // Server-maintained aggregate derived from milestone execution state.
  progress Int      @default(0)
  budget   Decimal? @db.Decimal(14, 2)
  currency String   @default("NGN")

  startedAt     DateTime?
  expectedEndAt DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client         User?           @relation("ProjectClient", fields: [clientId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  portfolio    PortfolioProfile?
  technologies ProjectTechnology[]

  milestones            ProjectMilestone[]
  milestoneDependencies ProjectMilestoneDependency[]
  features              ProjectFeature[]
  featureDependencies   ProjectFeatureDependency[]
  tasks                 ProjectTask[]

  updates      ProjectUpdate[]
  activities   ProjectActivity[]
  assignments  ProjectAssignment[]
  attributions ProjectAttribution[]
  files        ProjectFile[]

  analytics     ProjectAnalytics?
  conversations Conversation[]
  media         MediaAsset[]
  comments      Comment[]
  reactions     Reaction[]
  seo           SeoMetadata?

  @@index([clientId])
  @@index([status])
  @@index([visibility])
  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([expectedEndAt])
}

model PortfolioProfile {
  id        String @id @default(cuid())
  projectId String @unique

  tagline       String?
  summary       String?
  challenge     String?
  solution      String?
  outcome       String?
  liveUrl       String?
  repositoryUrl String?
  featured      Boolean   @default(false)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([featured])
  @@index([publishedAt])
}

model ProjectTechnology {
  id        String  @id @default(cuid())
  projectId String
  name      String
  slug      String
  icon      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
}

model ProjectMilestone {
  id          String @id @default(cuid())
  projectId   String
  createdById String

  title           String
  slug            String
  description     String?
  purpose         String?
  expectedOutcome String?

  status     ProjectMilestoneStatus   @default(PLANNED)
  priority   ProjectMilestonePriority @default(NORMAL)
  visibility ProjectUpdateVisibility  @default(CLIENT)
  sortOrder  Int                      @default(0)

  // Server-maintained aggregate derived from feature/task state.
  progress Int @default(0)

  startedAt   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  gitCommitSha    String?
  gitTag          String?
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MilestoneCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignments ProjectMilestoneAssignment[]
  features    ProjectFeature[]
  updates     ProjectUpdate[]
  files       ProjectFile[]

  dependencies ProjectMilestoneDependency[] @relation("MilestoneDependencies")
  dependents   ProjectMilestoneDependency[] @relation("MilestoneDependents")

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([visibility])
  @@index([dueDate])
  @@index([sortOrder])
}

model ProjectMilestoneAssignment {
  milestoneId String
  userId      String
  role        String?
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([milestoneId, userId])
  @@index([userId])
  @@index([removedAt])
}

model ProjectMilestoneDependency {
  projectId            String
  milestoneId          String
  dependsOnMilestoneId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestone          ProjectMilestone @relation("MilestoneDependencies", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOnMilestone ProjectMilestone @relation("MilestoneDependents", fields: [dependsOnMilestoneId], references: [id], onDelete: Cascade)

  @@id([milestoneId, dependsOnMilestoneId])
  @@index([projectId])
  @@index([dependsOnMilestoneId])
}

model ProjectFeature {
  id          String  @id @default(cuid())
  projectId   String
  milestoneId String?

  createdById   String
  nominatedById String?
  assignedToId  String?

  name               String
  slug               String
  description        String?
  expectedOutcome    String?
  acceptanceCriteria Json?

  status    ProjectFeatureStatus   @default(BACKLOG)
  priority  ProjectFeaturePriority @default(NORMAL)
  progress  Int                    @default(0)
  sortOrder Int                    @default(0)

  nominatedAt DateTime?
  approvedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  createdBy   User  @relation("FeatureCreator", fields: [createdById], references: [id], onDelete: Restrict)
  nominatedBy User? @relation("FeatureNominator", fields: [nominatedById], references: [id], onDelete: SetNull)
  assignedTo  User? @relation("FeatureAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  tasks   ProjectTask[]
  updates ProjectUpdate[]
  files   ProjectFile[]

  dependencies ProjectFeatureDependency[] @relation("FeatureDependencies")
  dependents   ProjectFeatureDependency[] @relation("FeatureDependents")

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([milestoneId])
  @@index([createdById])
  @@index([nominatedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([sortOrder])
}

model ProjectFeatureDependency {
  projectId          String
  featureId          String
  dependsOnFeatureId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  feature          ProjectFeature @relation("FeatureDependencies", fields: [featureId], references: [id], onDelete: Cascade)
  dependsOnFeature ProjectFeature @relation("FeatureDependents", fields: [dependsOnFeatureId], references: [id], onDelete: Cascade)

  @@id([featureId, dependsOnFeatureId])
  @@index([projectId])
  @@index([dependsOnFeatureId])
}

model ProjectTask {
  id        String @id @default(cuid())
  projectId String
  featureId String

  createdById  String
  assignedToId String?

  title       String
  description String?

  status    ProjectTaskStatus   @default(TODO)
  priority  ProjectTaskPriority @default(NORMAL)
  progress  Int                 @default(0)
  sortOrder Int                 @default(0)

  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature ProjectFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdBy  User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([featureId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([sortOrder])
}

model ProjectAssignment {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  role       String?
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([removedAt])
}

model ProjectUpdate {
  id          String  @id @default(cuid())
  projectId   String
  milestoneId String?
  featureId   String?
  authorId    String?

  title       String
  description String
  type        ProjectUpdateType       @default(GENERAL)
  visibility  ProjectUpdateVisibility @default(CLIENT)
  progress    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  feature   ProjectFeature?   @relation(fields: [featureId], references: [id], onDelete: SetNull)
  author    User?             @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  media MediaAsset[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([featureId])
  @@index([authorId])
  @@index([type])
  @@index([visibility])
  @@index([createdAt])
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  userId    String?

  type        ActivityType
  title       String
  description String?
  visibility  ProjectUpdateVisibility @default(CLIENT)
  metadata    Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([type])
  @@index([visibility])
  @@index([createdAt])
}

model ProjectFile {
  id          String  @id @default(cuid())
  projectId   String
  milestoneId String?
  featureId   String?
  uploaderId  String?

  name       String
  url        String
  mimeType   String?
  size       Int?
  visibility ProjectUpdateVisibility @default(CLIENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  feature   ProjectFeature?   @relation(fields: [featureId], references: [id], onDelete: SetNull)
  uploader  User?             @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@index([featureId])
  @@index([uploaderId])
  @@index([visibility])
}

model ProjectAttribution {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  name      String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// =========================================================
// COMMERCE
// =========================================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id         String  @id @default(cuid())
  categoryId String?

  name             String
  slug             String  @unique
  shortDescription String?
  description      String?

  type   ProductType
  status ProductStatus @default(DRAFT)

  price          Decimal  @db.Decimal(14, 2)
  compareAtPrice Decimal? @db.Decimal(14, 2)
  currency       String   @default("NGN")

  sku            String? @unique
  trackInventory Boolean @default(true)
  featured       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  digital  DigitalProduct?
  media    MediaAsset[]
  seo      SeoMetadata?

  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([featured])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  name       String
  sku        String?  @unique
  price      Decimal? @db.Decimal(14, 2)
  attributes Json?
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  InventoryItem?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([isDefault])
}

model DigitalProduct {
  id        String @id @default(cuid())
  productId String @unique

  description String?
  version     String?
  fileName    String?
  fileSize    Int?
  fileType    String?
  downloadUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveries DigitalDelivery[]
}

model InventoryItem {
  id        String @id @default(cuid())
  variantId String @unique

  quantity          Int @default(0)
  reserved          Int @default(0)
  lowStockThreshold Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
}

model InventoryMovement {
  id          String @id @default(cuid())
  inventoryId String

  type     InventoryMovementType
  quantity Int
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id     String  @id @default(cuid())
  userId String?

  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax      Decimal @default(0) @db.Decimal(14, 2)
  shipping Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @db.Decimal(14, 2)

  currency String @default("NGN")

  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json?

  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  fulfillment   OrderFulfillment?
  media         MediaAsset[]
  conversations Conversation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String

  productName String
  variantName String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  digitalDelivery DigitalDelivery?

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  amount   Decimal         @db.Decimal(14, 2)
  currency String          @default("NGN")
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  reference String? @unique
  metadata  Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([provider])
}

model OrderFulfillment {
  id      String @id @default(cuid())
  orderId String @unique

  status          FulfillmentStatus @default(PENDING)
  trackingNumber  String?
  carrier         String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  shippingAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DigitalDelivery {
  id               String @id @default(cuid())
  orderItemId      String @unique
  digitalProductId String

  token  String                @unique
  status DigitalDeliveryStatus @default(PENDING)

  downloadCount    Int       @default(0)
  expiresAt        DateTime?
  lastDownloadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Restrict)

  @@index([digitalProductId])
  @@index([status])
}

// =========================================================
// BLOG / CONTENT
// =========================================================

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id         String  @id @default(cuid())
  authorId   String
  categoryId String?

  title   String
  slug    String  @unique
  excerpt String?
  content String

  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags      BlogPostTag[]
  comments  Comment[]
  reactions Reaction[]
  media     MediaAsset[]
  seo       SeoMetadata?

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
}

model BlogTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// =========================================================
// COMMENTS / REACTIONS
// Runtime validation must enforce exactly one target:
// either postId OR projectId.
// =========================================================

model Comment {
  id        String  @id @default(cuid())
  userId    String
  postId    String?
  projectId String?
  parentId  String?

  body   String
  status CommentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  post    BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([userId])
  @@index([postId])
  @@index([projectId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
}

model Reaction {
  id     String       @id @default(cuid())
  userId String
  type   ReactionType

  postId    String?
  projectId String?

  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  post    BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, projectId, type])
  @@index([userId])
  @@index([postId])
  @@index([projectId])
  @@index([type])
}

// =========================================================
// MESSAGING
// Runtime validation must enforce contextual ownership based on type.
// =========================================================

model Conversation {
  id     String             @id @default(cuid())
  type   ConversationType
  status ConversationStatus @default(ACTIVE)

  subject          String?
  projectId        String?
  serviceRequestId String?
  orderId          String?
  supportTicketId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supportTicket  SupportTicket?  @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([serviceRequestId])
  @@index([orderId])
  @@index([supportTicketId])
  @@index([type])
  @@index([status])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?
  mutedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  body String?

  replyToId String?
  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  replyTo     Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]           @relation("MessageReplies")
  attachments MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([deletedAt])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  type      AttachmentType

  url          String
  thumbnailUrl String?
  fileName     String?
  mimeType     String?
  size         Int?

  width     Int?
  height    Int?
  duration  Int?
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([type])
}

// =========================================================
// SUPPORT / ASSISTANCE
// =========================================================

model AssistanceRequest {
  id     String @id @default(cuid())
  userId String

  subject String
  message String
  status  AssistanceStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportTicket {
  id         String  @id @default(cuid())
  creatorId  String
  assigneeId String?

  ticketNumber String @unique
  subject      String
  description  String

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  creator  User  @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// =========================================================
// NOTIFICATIONS
// =========================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  title   String
  message String

  href       String?
  entityType String?
  entityId   String?
  metadata   Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  emailNotifications     Boolean @default(true)
  pushNotifications      Boolean @default(true)
  messageNotifications   Boolean @default(true)
  projectNotifications   Boolean @default(true)
  serviceNotifications   Boolean @default(true)
  orderNotifications     Boolean @default(true)
  marketingNotifications Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// ANALYTICS
// =========================================================

model AnalyticsSession {
  id         String @id @default(cuid())
  sessionKey String @unique

  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  userId String?

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([lastSeenAt])
}

model AnalyticsEvent {
  id String @id @default(cuid())

  userId    String?
  sessionId String?

  type       AnalyticsEventType
  path       String?
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  user    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  session AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ProjectAnalytics {
  id        String @id @default(cuid())
  projectId String @unique

  views       Int @default(0)
  uniqueViews Int @default(0)
  reactions   Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  downloads   Int @default(0)

  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([lastViewedAt])
}

// =========================================================
// AUDIT LOGS
// =========================================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action     String
  entityType String?
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// =========================================================
// MEDIA
// Runtime validation must enforce exactly one owner relation.
// =========================================================

model MediaAsset {
  id String @id @default(cuid())

  url      String
  publicId String?

  fileName String?
  mimeType String?
  size     Int?

  width  Int?
  height Int?

  alt       String?
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId          String?
  serviceId       String?
  projectId       String?
  projectUpdateId String?
  productId       String?
  blogPostId      String?
  orderId         String?

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUpdate ProjectUpdate? @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  blogPost      BlogPost?      @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([projectId])
  @@index([projectUpdateId])
  @@index([productId])
  @@index([blogPostId])
  @@index([orderId])
}

// =========================================================
// SEO
// Runtime validation must enforce exactly one owner relation.
// =========================================================

model SeoMetadata {
  id String @id @default(cuid())

  title       String?
  description String?
  keywords    String?

  canonicalUrl String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  robots SeoRobots @default(INDEX_FOLLOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId  String? @unique
  productId  String? @unique
  blogPostId String? @unique
  projectId  String? @unique

  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  blogPost BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
