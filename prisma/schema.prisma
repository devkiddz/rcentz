  PHYSICAL
  BUNDLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
  DAMAGE
  RESERVATION
  RELEASE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  MANUAL
  OTHER
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DigitalDeliveryStatus {
  PENDING
  AVAILABLE
  DOWNLOADED
  EXPIRED
  REVOKED
}

enum BlogPostStatus {
