generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// ENUMS
// =========================================================

enum UserRole {
  USER
  CLIENT
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ProjectType {
  WEBSITE
  WEB_APP
  MOBILE_APP
  DESKTOP_APP
  SAAS
  API
  ECOMMERCE
  BRANDING
  GRAPHIC_DESIGN
  CONSULTING
  MAINTENANCE
  OTHER
}

enum ProjectStatus {
  PLANNING
  DISCOVERY
  DESIGN
  DEVELOPMENT
  TESTING
  REVIEW
  DEPLOYMENT
  MAINTENANCE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ProjectMilestoneStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

enum ProjectMilestonePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ProjectFeatureStatus {
  BACKLOG
  PROPOSED
  NOMINATED
  APPROVED
  IN_PROGRESS
  TESTING
  REVIEW
  COMPLETED
  REJECTED
  DEFERRED
}

enum ProjectFeaturePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

enum ProjectTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProjectUpdateType {
  GENERAL
  MILESTONE
  PROGRESS
  DEPLOYMENT
  MAINTENANCE
  ISSUE
  COMPLETION
  NEW_FEATURE
  IMPROVEMENT
  REDESIGN
  PERFORMANCE
  SECURITY
  BUG_FIX
  ANNOUNCEMENT
}

enum ProjectUpdateVisibility {
  INTERNAL
  CLIENT
  PUBLIC
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ServiceRequestStatus {
  PENDING
  REVIEWING
  QUOTED
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProductType {
